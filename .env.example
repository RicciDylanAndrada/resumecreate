# Required: your Anthropic API key (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Optional: which Claude model writes the résumés
ANTHROPIC_MODEL=claude-sonnet-5-5

# Optional: TypeSafe AI key. When set, Jev scores the gates for every draft
# (https://console.typesafe.ai). Without it, Claude scores them.
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest

# Optional: if set, visitors must enter this code before the site will
# spend your API credits. Recommended for a public deployment.
ACCESS_CODE=

# Optional: LaTeX compile service (YtoTech latex-on-http compatible)
LATEX_COMPILE_URL=https://latex.ytotech.com/builds/sync
